# -----------------------------------------------------------------
# PJR Swagrooha Foods - Environment Variables Configuration
# Set these variables in your hosting dashboard (e.g. Render.com / Vercel)
# -----------------------------------------------------------------

# 1. AUTOMATIC CUSTOMER GMAIL RECEIPT
# Use your Gmail address and 16-character App Password (from Google Account -> Security -> App Passwords)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=abcd efgh ijkl mnop

# 2. AUTOMATIC OWNER WHATSAPP NOTIFICATION (via CallMeBot - FREE)
# Step 1: Send "I allow callmebot to send me messages" on WhatsApp to +34 644 59 77 16
# Step 2: Paste your admin phone number and the API Key received from CallMeBot below
CALLMEBOT_PHONE=918125154114
CALLMEBOT_APIKEY=123456

# 3. AUTOMATIC CUSTOMER WHATSAPP RECEIPT (choose ONE option below)
#
# Option A: UltraMsg (RECOMMENDED - no customer opt-in needed, free plan available)
#   Sign up at https://ultramsg.com, create a WhatsApp instance, scan the QR to connect your WhatsApp
ULTRAMSG_INSTANCE_ID=your_instance_id
ULTRAMSG_TOKEN=your_token
#
# Option B: Meta WhatsApp Cloud API (official but requires business verification)
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
#
# Option C: Twilio WhatsApp (sandbox available for testing)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# (Optional) Database URL for PostgreSQL on Render
# DATABASE_URL=postgres://...

# 5. ADMIN PANEL CREDENTIALS (Move these to Render env vars, never commit real values)
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASS=your_secure_password
